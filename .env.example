# Required for Gemini AI diagnosis, artisan briefs, quote fairness, dispute summaries
# Get your key at https://aistudio.google.com/
# Leave blank to run in demo mode with pre-built mock responses
GEMINI_API_KEY=

# Required for Google Places autocomplete (location field)
# Leave blank to disable autocomplete (free text still works)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase / Firestore (optional — app runs fully in demo mode without these)
# Demo mode uses localStorage instead of Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo mode flag (always true in this submission — no real payments or auth)
NEXT_PUBLIC_DEMO_MODE=true
