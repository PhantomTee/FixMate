# =============================================================
# Handijob – Environment Variables
# Copy this file to .env.local and fill in the values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# =============================================================

# ── AI ────────────────────────────────────────────────────────
# Gemini: diagnosis, artisan briefs, quote fairness, dispute summaries
# Get key at https://aistudio.google.com/
# Leave blank to use mock responses (demo mode)
GEMINI_API_KEY=

# ── Google Maps ───────────────────────────────────────────────
# Places autocomplete on location fields
# Leave blank to disable (free text still works)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Supabase ──────────────────────────────────────────────────
# Create a project at https://supabase.com, then run the
# migrations in supabase/migrations/ via the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server-only, never expose to client

# ── Paystack ──────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
# Set webhook URL to: https://yourdomain.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=          # sk_live_... or sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=  # pk_live_... or pk_test_...

# ── WhatsApp Business API ─────────────────────────────────────
# Meta for Developers → App → WhatsApp → Configuration
# Webhook URL: https://yourdomain.com/api/whatsapp/webhook
# Set webhook fields: messages
WHATSAPP_VERIFY_TOKEN=        # pick any random string for Meta verification
WHATSAPP_ACCESS_TOKEN=        # permanent token from Meta app
WHATSAPP_PHONE_NUMBER_ID=     # from WhatsApp → API Setup page

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Legacy / unused ───────────────────────────────────────────
# Firebase keys kept for reference; Supabase replaces Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
