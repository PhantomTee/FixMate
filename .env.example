# =============================================================
# iSabi – Environment Variables
# Copy this file to .env.local and fill in the values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# =============================================================

# ── AI (Groq) ─────────────────────────────────────────────────
# Diagnosis, artisan briefs, quote fairness, dispute summaries.
# Get key at https://console.groq.com/keys
# Leave blank to use safe mock responses (demo mode).
GROQ_API_KEY=

# ── AI (Gemini) — KYC identity verification ───────────────────
# Free tier at https://aistudio.google.com/apikey
# Used for NIN OCR + selfie face-match in artisan onboarding.
# Leave blank to use demo-mode pass-through (no real verification).
GEMINI_API_KEY=

# ── Google Maps ───────────────────────────────────────────────
# Places autocomplete on location fields.
# Leave blank to disable (free text still works).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# ── Supabase ──────────────────────────────────────────────────
# Create a project at https://supabase.com, then run the
# migrations in supabase/migrations/ via the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only, never expose to client

# ── Paystack ──────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
# Set webhook URL to: https://yourdomain.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=             # sk_live_... or sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY= # pk_live_... or pk_test_...

# ── WhatsApp FAB (floating button shown on every page) ────────
# Number digits only (no + or spaces), e.g. 14155238886
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Pre-filled text when user taps the button.
# Set to your Twilio sandbox join code while testing.
# Delete this var once you have a real WhatsApp Business number.
NEXT_PUBLIC_WHATSAPP_JOIN_CODE=join whistle-bear

# ── WhatsApp — Termii (primary, Nigeria-first) ─────────────────
# https://termii.com → Dashboard → Settings → API Key
# Webhook URL: https://yourdomain.com/api/whatsapp/webhook
TERMII_API_KEY=
TERMII_SENDER_ID=iSabi           # your approved WhatsApp sender ID
WHATSAPP_VERIFY_TOKEN=           # any random string for webhook verification

# ── WhatsApp — Twilio (alternative / sandbox testing) ─────────
# https://console.twilio.com → Messaging → Try WhatsApp Sandbox
# Webhook URL: https://yourdomain.com/api/whatsapp/twilio
# Leave blank if using Termii.
TWILIO_ACCOUNT_SID=              # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=          # whatsapp:+14155238886

# ── Admin access ──────────────────────────────────────────────
# Comma-separated list of emails / phone numbers with admin access.
# Alternatively set user_metadata.role = "admin" in Supabase Auth.
ADMIN_EMAIL_WHITELIST=
ADMIN_PHONE_WHITELIST=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Cron ──────────────────────────────────────────────────────
# Random string to protect the auto-release cron endpoint.
# Add this to Vercel Environment Variables.
CRON_SECRET=
